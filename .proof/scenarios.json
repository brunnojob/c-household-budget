{
  "repository": "brunnojob/c-household-budget",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/demo.py"
  ],
  "cases": [
    {
      "name": "make",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "make"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "Budget aggregation and invalid calendar input",
      "argv": [
        "python",
        ".proof/demo.py"
      ],
      "contains": [
        "\"netMinor\": 85000",
        "invalid calendar date rejected"
      ],
      "timeout": 120
    }
  ]
}
